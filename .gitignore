# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
*.env
# Non-secret, per-environment docker-compose config is meant to be versioned —
# unlike default.env (a local-only, gitignored bypass of Vault), these carry no
# credentials, only bootstrap identity (profile, Config Server/Vault URLs, etc.).
!config/*.env
target/
htmlReport/
.idea/
.sonarlint/
.ai/*
/.github/agents/
/docs/

# TLS/SSL credentials and keystores — never commit real certs/keys
*.pem
*.key
*.jks
*.p12
*.pfx
*.cert
*.crt

# OS / tooling noise
.DS_Store

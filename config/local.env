# Non-secret, per-environment bootstrap config for docker-compose. Versioned on
# purpose (see the .gitignore exception for config/*.env) — nothing in this file
# is a credential. It only tells mercury which environment it's running against
# and how to reach the Vault/Config Server that then supplies everything else
# (DB, Mongo, mail, OAuth, Kafka SASL, etc. all come from Vault's KV store at
# runtime, keyed per environment — they never belong in this file or in Helm).
#
# The one bootstrap secret Vault itself can't hand us — the token to reach Vault
# in the first place — lives in secrets/local.env (gitignored), not here.

VIRTUAL_HOST=mercury.umdc-qa.tst
APP_PORT=8118

SPRING_BOOT_PROFILE_ACTIVE=remote-supabase
SPRING_CLOUD_CONFIG_LABEL=Develop

VAULT_ENABLED=true
SPRING_CLOUD_VAULT_ENABLED=true
VAULT_URI=https://vault.umdc-qa.tst
VAULT_KV_BACKEND=dev

CNFS_URI=https://config-server.umdc-qa.tst

# Service-discovery registration vars — mercury has no eureka-client dependency
# (checked pom.xml) so its own JVM never reads these; kept here only in case an
# external nginx-proxy/service-monitor sidecar on the shared network consumes them.
SD_INSTANCE_HOST_NAME=monitor.umdc-qa.tst
SD_PORT=443
SD_REGISTER_ENABLED=true
SD_URL=https://monitor.umdc-qa.tst

# Host directory bind-mounted read-only over /usr/local/runme/templates by
# docker-compose.yml, letting ops swap FreeMarker .ftl templates without rebuilding
# the image (which already bakes in src/main/resources/templates as the default —
# see Dockerfile). Unlike every other variable above, mercury's own JVM never reads
# this one (it's not a ${...} placeholder in application.yml) — it's consumed by
# Docker Compose itself to resolve the volumes: host path, which is why `docker
# compose` must be invoked with --env-file config/local.env (see docs/tec/*/06-*)
# instead of relying on Compose's default project-root .env lookup.
#
# Windows example: MERCURY_TEMPLATES_HOST_PATH=C:\ambientes\mercury\templates
# Linux/macOS example: MERCURY_TEMPLATES_HOST_PATH=/opt/mercury/templates
MERCURY_TEMPLATES_HOST_PATH=./src/main/resources/templates

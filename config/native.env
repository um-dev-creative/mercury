# Build/smoke-test only config for the "native" Spring profile (MER-5: GraalVM Native Image).
# Versioned on purpose (see the .gitignore exception for config/*.env) — every value below is a
# harmless placeholder, never a credential, and none of it points at real infrastructure.
#
# Why this file exists: `spring-boot:process-aot` and the resulting native binary both require a
# full ApplicationContext refresh to succeed — unlike a plain `mvn test` run, there is no way to
# mock your way around it. application.yml's ~46 undefaulted ${VAR} placeholders are normally filled
# in by Vault/Config Server at runtime (see config/local.env + secrets/local.env), which requires
# live QA infrastructure this build does not have access to and should not depend on. This file
# supplies safe, syntactically-valid dummy values for all of them instead, so the app can boot far
# enough for AOT processing / native-image compilation / a local smoke test without touching Vault,
# Config Server, Postgres, MongoDB, Kafka, or Eureka. It is not a deployment configuration.
#
# Usage: set -a; source config/native.env; set +a; mvn -Pnative clean package -DskipTests
#
# Known non-fatal noise with this file: HikariCP retries a Postgres connection to localhost:5432
# every ~30s and the MongoDB driver retries a DNS SRV lookup for localhost every ~10s, both in a
# background thread — neither blocks context refresh or the native build (see
# docs/architecture/graalvm-native-image.md).

SPRING_BOOT_PROFILE_ACTIVE=native
VAULT_ENABLED=false
# spring.config.import (application.yml) already declares "optional:vault://,optional:configserver:"
# so this alone would be enough to skip both safely — set explicitly anyway for clarity/defense.
SPRING_CLOUD_CONFIG_ENABLED=false
SPRING_CLOUD_CONFIG_LABEL=native
CNFS_URI=http://localhost:9999
LOGGING_TRACE_ENABLED=false
AUTH_ROLE_ID=none
APP_PORT=8118
AUTH_CERT_URI=/protocol/openid-connect/certs
AUTH_CLIENT_ID=dummy
AUTH_CLIENT_SECRET=dummy
AUTH_RESOURCE_PRINCIPAL=dummy
AUTH_TOKEN_URI=http://localhost:9999/token
AUTH_URI=http://localhost:9999/auth
BACKBONE_CLIENT_ID=dummy
BACKBONE_CLIENT_SECRET=dummy
BACKBONE_GRANT_TYPE=client_credentials
BACKBONE_PASSWORD=dummy
BACKBONE_SCOPE=dummy
BACKBONE_USERNAME=dummy
BOOTSTRAP_SERVER_PORT=9999
BOOTSTRAP_SERVER_URI=localhost
MAIL_HOST=localhost
MAIL_PASSWORD=dummy
MAIL_PORT=25
MAIL_PROTOCOL=smtp
MAIL_USERNAME=dummy
MERCURY_CLIENT_ID=dummy
MERCURY_CLIENT_SECRET=dummy
MERCURY_DB_NAME=mercury
MERCURY_DB_PASSWORD=dummy
MERCURY_DB_PORT=5432
MERCURY_DB_URI=localhost
MERCURY_DB_USERNAME=mercury
MERCURY_EMAIL_TOPIC=mercury-email-messages
MERCURY_GRANT_TYPE=password
MERCURY_PASSWORD=dummy
MERCURY_SCOPE=dummy
MERCURY_USERNAME=dummy
MONGO_DATABASE=mercury
MONGO_HOST=localhost
MONGO_PASSWORD=dummy
MONGO_PORT=27017
MONGO_USERNAME=mercury
PRX_VERIFICATION_CODE_TEMPLATE_ID=00000000-0000-0000-0000-000000000000
TEMPLATE_SUFFIX=.ftl
VAULT_TOKEN=dummy
EUREKA_CLIENT_ENABLED=false
# Added while chasing the missing-ServletWebServerFactory bug below, on the (reasonable but,
# per docs/architecture/graalvm-native-image.md, ultimately WRONG) hypothesis that
# spring-boot-starter-web + spring-boot-starter-jersey coexisting on the classpath was the cause.
# The real cause was the legacy Spring Cloud Bootstrap Context (fixed by the application.yml
# migration); these two were never re-tested for removal afterwards, but Jersey/JAX-RS is
# genuinely unused anywhere in src/main/java, so excluding its autoconfiguration is harmless
# either way. Must be combined with application.yml's own spring.autoconfigure.exclude
# (ServletWebSecurityAutoConfiguration) since env-var list properties replace, not merge.
SPRING_MAIN_WEB_APPLICATION_TYPE=servlet
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.security.autoconfigure.web.servlet.ServletWebSecurityAutoConfiguration,org.springframework.boot.jersey.autoconfigure.JerseyAutoConfiguration
# Works around a known upstream bug (spring-projects/spring-data-commons#3499): Spring Data's
# AOT repository generator emits an invalid @Constraint annotation for any repository method
# with a jakarta.validation parameter annotation (@NotNull, @Size, etc. on findByX method args),
# failing generated-source compilation with "is not a repeatable annotation interface". Disabling
# AOT repository generation falls back to normal runtime repository proxies (still fully
# native-image compatible, just without that specific optimization) until upstream fixes it.
SPRING_AOT_REPOSITORIES_ENABLED=false
SPRING_DATASOURCE_HIKARI_INITIALIZATION_FAIL_TIMEOUT=-1
SPRING_JPA_PROPERTIES_HIBERNATE_BOOT_ALLOW_JDBC_METADATA_ACCESS=false

# TEMPLATE_PATH must be an ABSOLUTE FILESYSTEM path, not a classpath: URI — FreeMarkerConfig.java
# calls `new File(templateLoaderPath)` directly rather than using Spring resource loading. In
# Docker this is baked in as /usr/local/runme/templates (see Dockerfile); set it to the repo's
# own src/main/resources/templates when running this file locally, e.g.:
#   export TEMPLATE_PATH="$(pwd)/src/main/resources/templates"
